<div id="LoginSection">
    <button id="createLobby" disabled>CREATE LOBBY</button>
    <button id="joinLobby" disabled>JOIN LOBBY</button>

    <div id="signupForm">
        <div>
            <form id="signupFormReal">
                <h3>MAKE AN ACCOUNT :33333</h3>
                <input
                    type="password"
                    required
                    placeholder="Password"
                    name="password"
                />
                <input
                    type="text"
                    required
                    placeholder="Username"
                    name="username"
                />
                <input
                    type="text"
                    required
                    placeholder="Real Name"
                    name="realName"
                />
                <input type="email" required placeholder="Email" name="email" />
                <input
                    type="color"
                    required
                    placeholder="Favorate Color"
                    name="favColor"
                />
                <input
                    type="month"
                    required
                    placeholder="What month you born?"
                    name="month"
                />
                <textarea
                    name="personalStory"
                    cols="30"
                    rows="10"
                    placeholder="A personal story about yourself"
                    required
                    minlength="100"></textarea>
                <select name="meerkats" id="" required>
                    <option value="no">No i suck</option>
                    <option value="yes">Meerkats</option>
                </select>
                <button type="submit">SEND ZE INFO</button>
            </form>
            <form>
                <h3>GET BACK IN</h3>
                <input type="text" placeholder="Username" required />
                <input type="password" placeholder="Password" required />
                <button type="submit">HECK THE MATRIX</button>
            </form>
        </div>
        <div>
            <div>
                <h2>HAHA LOSER SIGN IN!</h2>
                <p>delicious personal information :3</p>
            </div>
        </div>
    </div>
</div>

<style>
    button {
        width: 200px;
        aspect-ratio: 4/1;
        transition: transform 0.2s ease;
    }

    button:hover {
        animation: elasticPing 0.6s ease-out;
    }

    button:active {
        animation: elasticPing 0.6s ease-out;
    }

    @keyframes elasticPing {
        0% {
            transform: scale(1);
        }
        30% {
            transform: scale(1.15);
        }
        50% {
            transform: scale(0.95);
        }
        70% {
            transform: scale(1.05);
        }
        85% {
            transform: scale(0.98);
        }
        100% {
            transform: scale(1);
        }
    }

    #createLobby {
        position: absolute;
        left: 25%;
        rotate: -10deg;
    }

    #joinLobby {
        position: absolute;
        right: 25%;
        rotate: 10deg;
    }

    #signupForm {
        position: absolute;
        border: 5px solid black;
        border-radius: 20px;
        width: 50%;
        z-index: 1;
        left: 25%;
        top: 25%;
        background-color: white;
    }

    #signupForm > div {
        display: flex;
        flex-direction: row;
        gap: 15px;
        justify-content: space-between;
    }

    #signupForm form {
        display: flex;
        flex-direction: column;
        width: 100%;
    }

    #signupForm form > h3 {
        text-align: center;
    }

    textarea {
        resize: none;
    }
</style>

<script>
    import { onAuthStateChanged } from "firebase/auth";
    import {
        AUTH,
        createAccount,
        getUser,
        type SignUpFormData,
    } from "./firebase";
    let signupFormReal = document.getElementById(
        "signupFormReal",
    ) as HTMLFormElement;
    let creatLobbyButton = document.getElementById(
        "createLobby",
    ) as HTMLButtonElement;
    let joinLobbyButton = document.getElementById(
        "joinLobby",
    ) as HTMLButtonElement;

    onAuthStateChanged(AUTH, (user) => {
        if (user !== null) {
            signupFormReal.hidden = true;
            creatLobbyButton.hidden = false;
            joinLobbyButton.hidden = false;
        } else {
            signupFormReal.hidden = false;
            creatLobbyButton.hidden = true;
            joinLobbyButton.hidden = true;
        }
    });

    signupFormReal.addEventListener("submit", async (event) => {
        event.preventDefault();
        let formData = new FormData(
            signupFormReal,
        ) as unknown as SignUpFormData;

        await createAccount(formData);

        console.log(formData);
    });
</script>
    
